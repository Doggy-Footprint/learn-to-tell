{
  "name": "learn-to-tell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.8.1",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "verify": "node --test --experimental-test-coverage --test-coverage-include='contracts/*.mjs' --test-coverage-include='examples/manufacturing-inspection/*.mjs' --test-coverage-include='learning/*.mjs' --test-coverage-include='knowledge/*.mjs' --test-coverage-include='authoring/*.mjs' --test-coverage-include-all --test-coverage-lines=100 --test-coverage-functions=100 tests/*.test.mjs && playwright test",
    "build": "node scripts/build-lesson.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@observablehq/framework": "1.13.4",
    "@playwright/test": "1.63.0"
  }
}
